[mysqld]
# Compose's API runs in another container. The host port is loopback-only in
# docker-compose.yaml; 127.0.0.1 here would make the database unreachable to it.
bind-address=0.0.0.0

character-set-server=utf8mb4
collation-server=utf8mb4_general_ci

# Note: lower_case_table_names can ONLY be set at data-dir init time.
# Setting it after MySQL has started will crash the service.
# Existing data must be migrated explicitly; never delete it to repair config.
# lower_case_table_names=1

# ===== 性能优化参数 (兼容 MySQL 5.7~9.x 和 MariaDB 10.x) =====

# InnoDB 缓冲池
# 建议根据实际内存调整：1GB内存设256M，2GB设512M，4GB设1G，8GB+设2G~4G
# 本项目默认256M，适合低配VPS（1~2GB内存）；大内存机器请手动调大
innodb_buffer_pool_size=256M

# InnoDB redo log 容量 (MySQL 8.0.30+)
# loose- is essential: MariaDB and MySQL <8.0.30 otherwise abort startup.
# Unsupported tuning uses that server's default, without touching stored data.
loose-innodb_redo_log_capacity=256M
# MariaDB names the same setting innodb_log_file_size.  Keeping this second
# loose option in the shared Compose file makes the tuning effective there too;
# MySQL safely ignores it on releases where the alias is unavailable. The
# all-in-one entrypoint still emits a strict engine-specific runtime option.
loose-innodb_log_file_size=256M

# InnoDB 日志缓冲区（减少磁盘 I/O）
innodb_log_buffer_size=16M

# 事务提交时的日志刷新策略
# 0=每秒刷新(最快但可能丢数据) 1=每次提交刷新(最安全但最慢) 2=每次提交写入但每秒刷新(平衡)
innodb_flush_log_at_trx_commit=2

# InnoDB 刷新方法（减少双写缓冲）
# 注意：Windows 不支持 O_DIRECT，会自动降级
loose-innodb_flush_method=O_DIRECT

# InnoDB I/O 容量（适配低配 VPS SSD）
innodb_io_capacity=200
innodb_io_capacity_max=400

# InnoDB 读写 I/O 线程（低配场景减少线程争抢）
innodb_read_io_threads=4
innodb_write_io_threads=4

# 每张表独立表空间
innodb_file_per_table=1

# 最大连接数
max_connections=500

# 线程缓存大小
thread_cache_size=100

# 表缓存（减少表打开开销）
table_open_cache=400
table_definition_cache=400

# 排序和连接缓冲区（每连接分配，不宜过大）
sort_buffer_size=2M
join_buffer_size=2M
read_buffer_size=1M
read_rnd_buffer_size=1M

# 最大允许数据包大小
max_allowed_packet=64M

# Binary log retention.
# Docker deployments can accumulate multi-GB binlogs quickly when traffic/audit
# tables are updated frequently. Keep a short recovery window by default.
# The loose- prefix keeps this config safe on engines that do not recognize the
# legacy MariaDB/MySQL 5.7 option name.
loose-expire_logs_days=3
loose-binlog_expire_logs_seconds=259200
max_binlog_size=256M

# Query Cache 配置（仅 MySQL 5.x 和 MariaDB 10.x 支持）
# MySQL 8.0+ 已完全移除 Query Cache，设置这些参数会导致启动失败
# 因此注释掉，让各版本使用默认值
# query_cache_type=0
# query_cache_size=0

# 临时表优化
tmp_table_size=64M
max_heap_table_size=64M

# 连接超时设置（10分钟）
wait_timeout=600
interactive_timeout=600

# 慢查询日志（建议在生产环境中启用以诊断性能问题）
# slow_query_log=1
# slow_query_log_file=/var/log/mysql/slow-query.log
# long_query_time=2

# ===== 兼容性说明 =====
# 本配置文件兼容：
# - MySQL 5.7+
# - MySQL 8.0+ (包括8.0.30+新版本)
# - MariaDB 10.x+
# 
# 注意事项：
# 1. innodb_buffer_pool_size 请根据实际服务器内存调整
# 2. 如需启用 Query Cache (仅MariaDB)，可手动取消注释相关配置
# 3. 慢查询日志路径需确保 MySQL 进程有写入权限

[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4
