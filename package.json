{
  "name": "dsh-plugin-oneclickvirt",
  "version": "0.3.1",
  "description": "Manage OneClickVirt virtual machines, containers and provider nodes in DeepSeek Harness.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": { "type": "git", "url": "git+https://github.com/oneclickvirt/oneclickvirt.git" },
  "homepage": "https://github.com/oneclickvirt/oneclickvirt#deepseek-harness-plugin",
  "keywords": ["dsh-plugin", "deepseek-harness", "oneclickvirt", "virtualization"],
  "engines": { "node": ">=22.6.0", "dsh": ">=0.2.2-rc.1 <0.3.0-0" },
  "exports": {
    ".": "./skills/dsh-plugin.mjs",
    "./client": "./skills/dsh-client.js",
    "./locale/en.json": "./skills/en.json",
    "./locale/zh.json": "./skills/zh.json",
    "./icon": "./skills/dsh-icon.svg"
  },
  "files": ["skills/dsh-plugin.mjs", "skills/dsh-service.mjs", "skills/dsh-store.mjs", "skills/dsh-client.js", "skills/dsh.patch.yml", "skills/dsh-icon.svg", "skills/en.json", "skills/zh.json", "skills/SKILL.md", "skills/SKILL_ZH.md", "README.md", "README_ZH.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build_dsh_client.mjs",
    "check": "node scripts/check_dsh_plugin.mjs",
    "test": "node --test skills/dsh-*.test.mjs",
    "prepack": "npm run check"
  },
  "publishConfig": { "access": "public" },
  "dsh": {
    "bundle": { "patch": "./skills/dsh.patch.yml", "platforms": ["darwin", "linux", "win32"] },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-locale"] }
  },
  "devDependencies": { "jsdom": "26.1.0", "react": "19.3.1", "react-dom": "19.3.1" }
}
